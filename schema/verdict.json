{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bankmanager.local/schema/verdict.json",
  "title": "Final verdict",
  "description": "GENERATED from schema/contracts/verdict.py. PRODUCED BY P3 (orchestrator.api.run_analysis). Rendered from ResearchState.",
  "$defs": {
    "AgentName": {
      "description": "The P3 agent roster (docs/pipeline.md).\n\nfinancial and business run in parallel; valuation, then scenario, then\nred_team, then synthesizer. `verifier` is the LLM half of audit/.",
      "enum": [
        "financial",
        "business",
        "valuation",
        "scenario",
        "red_team",
        "synthesizer",
        "verifier"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "Analysis": {
      "additionalProperties": true,
      "description": "The full output of one agent pass.",
      "properties": {
        "schema_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/AgentName"
        },
        "ticker": {
          "pattern": "^[A-Z]{1,5}([.-][A-Z])?$",
          "title": "Ticker",
          "type": "string"
        },
        "as_of": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "As Of",
          "type": "string"
        },
        "model": {
          "description": "Model id used, or 'mock'.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "tokens_in": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cost tracking (error K).",
          "title": "Tokens In"
        },
        "tokens_out": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Out"
        }
      },
      "required": [
        "schema_version",
        "agent",
        "ticker",
        "as_of",
        "model",
        "summary"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Consistency": {
      "additionalProperties": true,
      "description": "Whether score, P(beat S&P), expected return and verdict agree.",
      "properties": {
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "ok"
      ],
      "title": "Consistency",
      "type": "object"
    },
    "DataQuality": {
      "additionalProperties": true,
      "description": "Run-level data health, surfaced as a banner in the report (error E).",
      "properties": {
        "overall": {
          "description": "ok | partial | degraded",
          "title": "Overall",
          "type": "string"
        },
        "gaps": {
          "description": "Human-readable description of each gap.",
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "overall"
      ],
      "title": "DataQuality",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": true,
      "description": "A verbatim quote from a source, string-matched by the verifier.\n\nThe quote must appear in the text behind `source_id` after whitespace\nnormalization, or audit/ raises IssueType.UNSUPPORTED_CLAIM.",
      "properties": {
        "quote": {
          "description": "Verbatim text, copied not paraphrased.",
          "minLength": 8,
          "title": "Quote",
          "type": "string"
        },
        "source_id": {
          "pattern": "^src:[a-z0-9_]+:[A-Za-z0-9._:-]+$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "quote",
        "source_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": true,
      "description": "One assertion by an agent, with the evidence that makes it checkable.",
      "properties": {
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "trend": {
          "$ref": "#/$defs/Trend"
        },
        "evidence": {
          "description": "At least one verbatim quote. Empty evidence makes the finding invalid.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "numbers": {
          "description": "Numbers cited by this finding. Never arithmetic done by the LLM.",
          "items": {
            "$ref": "#/$defs/ValueObject"
          },
          "title": "Numbers",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "claim",
        "trend",
        "evidence",
        "confidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "HorizonProbabilities": {
      "additionalProperties": true,
      "description": "A bare probability per horizon (documented exception to the ValueObject rule).",
      "properties": {
        "short_term": {
          "description": "0-12m.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Short Term",
          "type": "number"
        },
        "medium_term": {
          "description": "1-3y.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Medium Term",
          "type": "number"
        },
        "long_term": {
          "description": "3-5y.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Long Term",
          "type": "number"
        }
      },
      "required": [
        "short_term",
        "medium_term",
        "long_term"
      ],
      "title": "HorizonProbabilities",
      "type": "object"
    },
    "HorizonValues": {
      "additionalProperties": true,
      "description": "A ValueObject per horizon. Keys match Scores so returns and scores align.",
      "properties": {
        "short_term": {
          "$ref": "#/$defs/ValueObject",
          "description": "0-12m."
        },
        "medium_term": {
          "$ref": "#/$defs/ValueObject",
          "description": "1-3y."
        },
        "long_term": {
          "$ref": "#/$defs/ValueObject",
          "description": "3-5y."
        }
      },
      "required": [
        "short_term",
        "medium_term",
        "long_term"
      ],
      "title": "HorizonValues",
      "type": "object"
    },
    "IssueType": {
      "description": "Every check the verifier can raise. Routing table: docs/verification.md.\n\nunresolved_fact            a cited fact_id does not exist\nrecompute_mismatch         a number does not match recomputation from its inputs\nprose_number_mismatch      a number in claim text disagrees with its ValueObject\nsuperseded_fact            a cited fact has a non-null superseded_by\nfuture_fact                a cited fact was filed after the run's as_of\nadjusted_as_gaap           a non-GAAP figure is presented as GAAP\nunsupported_claim          a qualitative claim's quote is not in the cited section\ncross_agent_contradiction  two sections assert incompatible things",
      "enum": [
        "unresolved_fact",
        "recompute_mismatch",
        "prose_number_mismatch",
        "superseded_fact",
        "future_fact",
        "adjusted_as_gaap",
        "unsupported_claim",
        "cross_agent_contradiction"
      ],
      "title": "IssueType",
      "type": "string"
    },
    "Mode": {
      "description": "How a run obtained its data. `backtest` implies a non-null as_of.",
      "enum": [
        "live",
        "mock",
        "backtest"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Prior": {
      "additionalProperties": true,
      "description": "The base rate for P(beat S&P), and how far the agents were allowed to move it.\n\nHistorically only about 40-45% of individual stocks beat the index over five\nyears. Starting from that and capping the LLM's tilt is what stops\nP(beat S&P) from being a number the model simply made up (error C).",
      "properties": {
        "base_rate": {
          "$ref": "#/$defs/HorizonProbabilities"
        },
        "requested_shift": {
          "description": "Sum of every agent's requested shift.",
          "title": "Requested Shift",
          "type": "number"
        },
        "applied_shift": {
          "description": "After the cap. |applied| <= cap.",
          "title": "Applied Shift",
          "type": "number"
        },
        "cap": {
          "description": "Hard cap from calc/config.py.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Cap",
          "type": "number"
        },
        "shift_reasons": {
          "description": "One entry per requesting agent.",
          "items": {
            "type": "string"
          },
          "title": "Shift Reasons",
          "type": "array"
        }
      },
      "required": [
        "base_rate",
        "requested_shift",
        "applied_shift",
        "cap"
      ],
      "title": "Prior",
      "type": "object"
    },
    "RedTeamBlock": {
      "additionalProperties": true,
      "description": "The bear case, and the Synthesizer's obligation to answer it (error 5).",
      "properties": {
        "summary": {
          "description": "Strongest case against the leading view.",
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "responses_by_synthesizer": {
          "description": "The Synthesizer MUST answer; an empty response is invalid.",
          "minLength": 1,
          "title": "Responses By Synthesizer",
          "type": "string"
        },
        "drawdown_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The strongest 30%+ drawdown path, if one was argued.",
          "title": "Drawdown Path"
        },
        "requested_prior_shift": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded in ScenarioResult.prior, applied within the cap.",
          "title": "Requested Prior Shift"
        }
      },
      "required": [
        "summary",
        "responses_by_synthesizer"
      ],
      "title": "RedTeamBlock",
      "type": "object"
    },
    "ReportSection": {
      "additionalProperties": true,
      "description": "One rendered section. `body_markdown` is GENERATED from Claims, never typed\nby an agent (ADR 0004).",
      "properties": {
        "id": {
          "description": "Matches a ResearchState section_key.",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "body_markdown": {
          "description": "Rendered from the section's Claims.",
          "title": "Body Markdown",
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/AgentName"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "pending"
        },
        "unverified_claim_ids": {
          "description": "Claims that failed after the retry cap. Rendered as marked.",
          "items": {
            "type": "string"
          },
          "title": "Unverified Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "body_markdown",
        "agent"
      ],
      "title": "ReportSection",
      "type": "object"
    },
    "RetryDirective": {
      "additionalProperties": true,
      "description": "An instruction to re-run ONE agent for ONE section, with the reasons.\n\nTargeted, not a whole-pipeline rerun: re-running everything would re-roll\nagents that already passed and would make cost unpredictable (error K).",
      "properties": {
        "target_agent": {
          "$ref": "#/$defs/AgentName"
        },
        "section_key": {
          "description": "The section to redo.",
          "minLength": 1,
          "title": "Section Key",
          "type": "string"
        },
        "issues": {
          "description": "Why. Passed back into the agent's prompt.",
          "items": {
            "$ref": "#/$defs/VerificationIssue"
          },
          "minItems": 1,
          "title": "Issues",
          "type": "array"
        },
        "attempt": {
          "description": "1-based attempt number.",
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "max_attempts": {
          "default": 2,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "required": [
        "target_agent",
        "section_key",
        "issues",
        "attempt"
      ],
      "title": "RetryDirective",
      "type": "object"
    },
    "ScenarioName": {
      "enum": [
        "bear",
        "base",
        "bull"
      ],
      "title": "ScenarioName",
      "type": "string"
    },
    "ScenarioOut": {
      "additionalProperties": true,
      "description": "One evaluated scenario: what the price would be, and what that returns.",
      "properties": {
        "probability": {
          "description": "The APPLIED weight, after bounding.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        },
        "price_target": {
          "$ref": "#/$defs/ValueObject"
        },
        "annualized_return": {
          "$ref": "#/$defs/ValueObject"
        }
      },
      "required": [
        "probability",
        "price_target",
        "annualized_return"
      ],
      "title": "ScenarioOut",
      "type": "object"
    },
    "ScenarioResult": {
      "additionalProperties": true,
      "description": "Everything calc/ derives from a Scenarios proposal plus the factsheet.",
      "properties": {
        "schema_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "ticker": {
          "pattern": "^[A-Z]{1,5}([.-][A-Z])?$",
          "title": "Ticker",
          "type": "string"
        },
        "as_of": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "As Of",
          "type": "string"
        },
        "scenarios": {
          "additionalProperties": {
            "$ref": "#/$defs/ScenarioOut"
          },
          "propertyNames": {
            "$ref": "#/$defs/ScenarioName"
          },
          "title": "Scenarios",
          "type": "object"
        },
        "weights": {
          "$ref": "#/$defs/ScenarioWeights",
          "description": "Bounded weights used for expected value, with the full clamp record."
        },
        "expected_annualized_return": {
          "$ref": "#/$defs/ValueObject",
          "description": "Weighted by the APPLIED weights, not the requested ones."
        },
        "sp500_expected_return": {
          "$ref": "#/$defs/ValueObject",
          "description": "Assumed index return (assumption)."
        },
        "expected_return_vs_sp500": {
          "$ref": "#/$defs/HorizonValues",
          "description": "Expected return minus the index, per horizon."
        },
        "excess_vs_sp500": {
          "$ref": "#/$defs/HorizonValues"
        },
        "p_beat_sp500": {
          "$ref": "#/$defs/HorizonProbabilities"
        },
        "prior": {
          "$ref": "#/$defs/Prior"
        },
        "scores": {
          "$ref": "#/$defs/Scores"
        },
        "consistency": {
          "$ref": "#/$defs/Consistency"
        }
      },
      "required": [
        "schema_version",
        "ticker",
        "as_of",
        "scenarios",
        "weights",
        "expected_annualized_return",
        "sp500_expected_return",
        "expected_return_vs_sp500",
        "excess_vs_sp500",
        "p_beat_sp500",
        "prior",
        "scores",
        "consistency"
      ],
      "title": "ScenarioResult",
      "type": "object"
    },
    "ScenarioWeights": {
      "additionalProperties": true,
      "description": "The bounded weights actually used to compute expected value.\n\nCarries one WeightClamp per scenario, always all three, so that a reader can\nreconstruct exactly what the agent asked for and what code did with it.",
      "properties": {
        "bear": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Bear",
          "type": "number"
        },
        "base": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Base",
          "type": "number"
        },
        "bull": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Bull",
          "type": "number"
        },
        "clamps": {
          "description": "One per scenario. Never fewer.",
          "items": {
            "$ref": "#/$defs/WeightClamp"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Clamps",
          "type": "array"
        },
        "any_clamped": {
          "description": "True when at least one weight was overruled.",
          "title": "Any Clamped",
          "type": "boolean"
        },
        "renormalized": {
          "description": "True when clamping forced a rescale.",
          "title": "Renormalized",
          "type": "boolean"
        }
      },
      "required": [
        "bear",
        "base",
        "bull",
        "clamps",
        "any_clamped",
        "renormalized"
      ],
      "title": "ScenarioWeights",
      "type": "object"
    },
    "Scores": {
      "additionalProperties": true,
      "description": "Buyability 1..10 per horizon, from calc/'s fixed rubric (docs/p2 rubric).",
      "properties": {
        "short_term": {
          "description": "0-12m.",
          "maximum": 10,
          "minimum": 1,
          "title": "Short Term",
          "type": "integer"
        },
        "medium_term": {
          "description": "1-3y.",
          "maximum": 10,
          "minimum": 1,
          "title": "Medium Term",
          "type": "integer"
        },
        "long_term": {
          "description": "3-5y.",
          "maximum": 10,
          "minimum": 1,
          "title": "Long Term",
          "type": "integer"
        }
      },
      "required": [
        "short_term",
        "medium_term",
        "long_term"
      ],
      "title": "Scores",
      "type": "object"
    },
    "Severity": {
      "description": "Verification issue severity. A single `error` fails the whole audit.",
      "enum": [
        "error",
        "warn"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TenThousandDollarAnswer": {
      "additionalProperties": true,
      "description": "The plain-language question a reader actually has.",
      "properties": {
        "choice": {
          "description": "this_stock | sp500",
          "title": "Choice",
          "type": "string"
        },
        "reason": {
          "description": "Written by the Synthesizer.",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "choice",
        "reason"
      ],
      "title": "TenThousandDollarAnswer",
      "type": "object"
    },
    "Trend": {
      "description": "Whether a finding reflects a durable change or a passing one.",
      "enum": [
        "structurally_positive",
        "temporarily_positive",
        "structurally_negative",
        "temporarily_negative",
        "neutral"
      ],
      "title": "Trend",
      "type": "string"
    },
    "Unit": {
      "description": "Unit of a ValueObject. `fraction` is never a percent (0.25 means 25%).",
      "enum": [
        "usd",
        "usd_per_share",
        "shares",
        "fraction",
        "multiple",
        "count",
        "days",
        "ratio"
      ],
      "title": "Unit",
      "type": "string"
    },
    "ValueObject": {
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          },
          "title": "status ok requires a numeric value"
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "source_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "source_id"
                ]
              },
              {
                "properties": {
                  "derived_from": {
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "derived_from"
                ]
              }
            ]
          },
          "title": "status ok requires a source_id or a non-empty derived_from"
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "title": "status unavailable requires a null value"
        },
        {
          "if": {
            "properties": {
              "unit": {
                "const": "fraction"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "maximum": 10.0,
                    "minimum": -10.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "title": "fractions are fractions, not percents"
        }
      ],
      "description": "Every reported or computed financial number in the system.\n\nFractions, not percents. Money in full USD. Missing data is\n{\"value\": null, \"status\": \"unavailable\"} - never 0, never \"N/A\", never an\nomitted key.\n\nA value computed in code from facts has type \"fact\" and lists `derived_from`.\nDiscount rate, terminal growth and exit multiples are \"assumption\".\nConsensus numbers and scenario outputs are \"estimate\".",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The number in full units, or null when status is unavailable.",
          "title": "Value"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "type": {
          "$ref": "#/$defs/ValueType"
        },
        "status": {
          "$ref": "#/$defs/ValueStatus"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^src:[a-z0-9_]+:[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the number came from. Required unless derived_from is set.",
          "title": "Source Id"
        },
        "derived_from": {
          "description": "Dotted paths or fact_ids this value was computed from.",
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        }
      },
      "required": [
        "value",
        "unit",
        "type",
        "status"
      ],
      "title": "ValueObject",
      "type": "object"
    },
    "ValueStatus": {
      "description": "`unavailable` is the ONLY way to express missing data. Never 0, never \"N/A\".",
      "enum": [
        "ok",
        "unavailable"
      ],
      "title": "ValueStatus",
      "type": "string"
    },
    "ValueType": {
      "description": "Epistemic status of a number, rendered as a colour in the report.\n\nfact       reported in a filing, or computed in code from reported values\nestimate   a forecast: consensus, or a scenario output\nassumption a chosen constant: discount rate, terminal growth, exit multiple",
      "enum": [
        "fact",
        "estimate",
        "assumption"
      ],
      "title": "ValueType",
      "type": "string"
    },
    "VerdictCard": {
      "additionalProperties": true,
      "description": "The card shown first, before any section (error 7 in the original review).",
      "properties": {
        "company": {
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "ticker": {
          "pattern": "^[A-Z]{1,5}([.-][A-Z])?$",
          "title": "Ticker",
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/ValueObject"
        },
        "market_cap": {
          "$ref": "#/$defs/ValueObject"
        },
        "thesis": {
          "description": "2-4 sentences, written by the Synthesizer.",
          "minLength": 1,
          "title": "Thesis",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/Scores",
          "description": "From calc/'s rubric. The LLM never sets these."
        },
        "p_beat_sp500_5y": {
          "description": "Equal to scenario_result.p_beat_sp500.long_term (3-5y).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Beat Sp500 5Y",
          "type": "number"
