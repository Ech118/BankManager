        },
        "expected_return_vs_sp500": {
          "$ref": "#/$defs/HorizonValues",
          "description": "Expected return minus the index, at 0-12m, 1-3y and 3-5y."
        },
        "primary_catalyst": {
          "minLength": 1,
          "title": "Primary Catalyst",
          "type": "string"
        },
        "biggest_risk": {
          "minLength": 1,
          "title": "Biggest Risk",
          "type": "string"
        },
        "valuation": {
          "description": "cheap | reasonable | expensive | extremely_expensive",
          "title": "Valuation",
          "type": "string"
        },
        "business_quality": {
          "description": "poor | average | good | excellent",
          "title": "Business Quality",
          "type": "string"
        },
        "financial_strength": {
          "description": "weak | average | strong | fortress",
          "title": "Financial Strength",
          "type": "string"
        },
        "verdict": {
          "description": "strong_buy | buy | speculative_buy | hold | avoid | sell. Must agree with calc.validate_consistency.",
          "title": "Verdict",
          "type": "string"
        },
        "ten_thousand_dollar_answer": {
          "$ref": "#/$defs/TenThousandDollarAnswer"
        }
      },
      "required": [
        "company",
        "ticker",
        "price",
        "market_cap",
        "thesis",
        "scores",
        "p_beat_sp500_5y",
        "expected_5y_return",
        "expected_return_vs_sp500",
        "primary_catalyst",
        "biggest_risk",
        "valuation",
        "business_quality",
        "financial_strength",
        "verdict",
        "ten_thousand_dollar_answer"
      ],
      "title": "VerdictCard",
      "type": "object"
    },
    "VerificationIssue": {
      "additionalProperties": true,
      "description": "One failed check, with enough detail to route a retry and to show the reader.",
      "properties": {
        "issue_type": {
          "$ref": "#/$defs/IssueType"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "path": {
          "description": "Dotted path into the audited object, e.g. sections.valuation.",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "message": {
          "description": "What is wrong, in one sentence.",
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "claim_id": {
          "anyOf": [
            {
              "pattern": "^claim:[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "fact_id": {
          "anyOf": [
            {
              "pattern": "^fact:[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact Id"
        },
        "section_id": {
          "anyOf": [
            {
              "pattern": "^sec:[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the check computed.",
          "title": "Expected"
        },
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the claim asserted.",
          "title": "Actual"
        },
        "checked_by_llm": {
          "default": false,
          "description": "True only for the qualitative-claim check.",
          "title": "Checked By Llm",
          "type": "boolean"
        }
      },
      "required": [
        "issue_type",
        "severity",
        "path",
        "message"
      ],
      "title": "VerificationIssue",
      "type": "object"
    },
    "VerificationResult": {
      "additionalProperties": true,
      "description": "The audit report. `passed` is false if any issue has severity 'error'.",
      "properties": {
        "schema_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/VerificationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "claims_checked": {
          "default": 0,
          "minimum": 0,
          "title": "Claims Checked",
          "type": "integer"
        },
        "claims_verified": {
          "default": 0,
          "minimum": 0,
          "title": "Claims Verified",
          "type": "integer"
        },
        "claims_unverified": {
          "default": 0,
          "description": "Shipped marked unverified after the retry cap.",
          "minimum": 0,
          "title": "Claims Unverified",
          "type": "integer"
        },
        "llm_checks_run": {
          "default": 0,
          "description": "Cost tracking; keep this number small.",
          "minimum": 0,
          "title": "Llm Checks Run",
          "type": "integer"
        },
        "retries_issued": {
          "items": {
            "$ref": "#/$defs/RetryDirective"
          },
          "title": "Retries Issued",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "passed"
      ],
      "title": "VerificationResult",
      "type": "object"
    },
    "VerificationStatus": {
      "description": "Lifecycle of a Claim through the verification gate (docs/verification.md).\n\nunverified is the terminal state for a claim that failed after the retry cap;\nthe report ships with it marked, rather than being blocked.",
      "enum": [
        "pending",
        "verified",
        "failed",
        "unverified"
      ],
      "title": "VerificationStatus",
      "type": "string"
    },
    "WeightClamp": {
      "additionalProperties": true,
      "description": "Audit record for ONE scenario weight, from request to applied value.\n\nThe pipeline is: requested -> clamped_to (band around default) -> applied\n(after renormalizing so the three weights sum to 1). Both steps are recorded\nseparately so a reader can see whether the agent was overruled, or merely\nrescaled because another weight was overruled.",
      "properties": {
        "scenario": {
          "$ref": "#/$defs/ScenarioName"
        },
        "requested": {
          "description": "What the Scenario Agent asked for.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Requested",
          "type": "number"
        },
        "clamped_to": {
          "description": "After the band clamp.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Clamped To",
          "type": "number"
        },
        "applied": {
          "description": "After renormalization. Used in the EV.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Applied",
          "type": "number"
        },
        "default_weight": {
          "description": "Configured default for this scenario.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Default Weight",
          "type": "number"
        },
        "band": {
          "description": "Configured +/- band around the default.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Band",
          "type": "number"
        },
        "was_clamped": {
          "description": "True when the band overruled the request.",
          "title": "Was Clamped",
          "type": "boolean"
        },
        "was_renormalized": {
          "description": "True when rescaling changed the clamped value.",
          "title": "Was Renormalized",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The agent's rationale for the requested weight.",
          "title": "Reason"
        }
      },
      "required": [
        "scenario",
        "requested",
        "clamped_to",
        "applied",
        "default_weight",
        "band",
        "was_clamped",
        "was_renormalized"
      ],
      "title": "WeightClamp",
      "type": "object"
    }
  },
