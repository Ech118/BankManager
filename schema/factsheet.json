{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bankmanager.local/schema/factsheet.json",
  "title": "Fact sheet",
  "description": "FROZEN CONTRACT. PRODUCED BY P1 (data.api.build_factsheet). CONSUMED BY P2 and P3. Contains REPORTED facts only: P1 never computes margins, FCF or ratios. Filing TEXT is not inlined; fetch with data.api.get_section_text(source_id).",
  "type": "object",
  "required": [
    "schema_version", "ticker", "company_name", "as_of", "built_at", "mode",
    "scope", "data_quality", "market", "financials", "peers", "sp500_baseline",
    "filing_sections", "news", "sources"
  ],
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/schema_version" },
    "ticker": { "$ref": "common.json#/$defs/ticker" },
    "company_name": { "type": "string", "minLength": 1 },
    "as_of": { "$ref": "common.json#/$defs/date" },
    "built_at": { "$ref": "common.json#/$defs/timestamp" },
    "mode": { "enum": ["live", "mock", "backtest"] },
    "scope": {
      "type": "object",
      "required": ["in_scope", "reason"],
      "properties": {
        "in_scope": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "data_quality": { "$ref": "common.json#/$defs/data_quality" },
    "market": {
      "type": "object",
      "required": ["price", "market_cap", "shares_outstanding", "enterprise_value"],
      "properties": {
        "price": { "$ref": "common.json#/$defs/value" },
        "market_cap": { "$ref": "common.json#/$defs/value" },
        "shares_outstanding": { "$ref": "common.json#/$defs/value" },
        "enterprise_value": { "$ref": "common.json#/$defs/value" }
      }
    },
    "financials": {
      "description": "One entry per period, NEWEST FIRST.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/financial_period" }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "market_cap", "pe", "ev_ebitda", "ev_revenue", "fcf_yield"],
        "properties": {
          "ticker": { "$ref": "common.json#/$defs/ticker" },
          "market_cap": { "$ref": "common.json#/$defs/value" },
          "pe": { "$ref": "common.json#/$defs/value" },
          "ev_ebitda": { "$ref": "common.json#/$defs/value" },
          "ev_revenue": { "$ref": "common.json#/$defs/value" },
          "fcf_yield": { "$ref": "common.json#/$defs/value" }
        }
      }
    },
    "sp500_baseline": {
      "type": "object",
      "required": ["forward_pe", "earnings_yield", "risk_free_rate", "as_of"],
      "properties": {
        "forward_pe": { "$ref": "common.json#/$defs/value" },
        "earnings_yield": { "$ref": "common.json#/$defs/value" },
        "risk_free_rate": { "$ref": "common.json#/$defs/value" },
        "as_of": { "$ref": "common.json#/$defs/date" }
      }
    },
    "consensus": {
      "description": "Optional. Values are type 'estimate'.",
      "type": "object",
      "properties": {
        "revenue_next_fy": { "$ref": "common.json#/$defs/value" },
        "eps_next_fy": { "$ref": "common.json#/$defs/value" }
      }
    },
    "filing_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source_id", "accession", "form", "char_count"],
        "properties": {
          "name": {
            "description": "Canonical section name.",
            "enum": ["business", "risk_factors", "mdna", "debt_note", "sbc_note", "segments_note", "other"]
          },
          "source_id": { "$ref": "common.json#/$defs/source_id" },
          "accession": { "type": "string" },
          "form": { "enum": ["10-K", "10-Q"] },
          "period": { "$ref": "common.json#/$defs/period" },
          "char_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "news": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["headline", "date", "url", "source_id"],
        "properties": {
          "headline": { "type": "string" },
          "date": { "$ref": "common.json#/$defs/date" },
          "url": { "type": "string" },
          "source_id": { "$ref": "common.json#/$defs/source_id" }
        }
      }
    },
    "sources": {
      "description": "Registry of every source_id used in this fact sheet.",
      "type": "object",
      "propertyNames": { "$ref": "common.json#/$defs/source_id" },
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "fetched_at"],
        "properties": {
          "kind": { "enum": ["edgar_xbrl", "edgar_text", "market", "fred", "news", "config", "mock"] },
          "url": { "type": ["string", "null"] },
          "accession": { "type": ["string", "null"] },
          "fetched_at": { "$ref": "common.json#/$defs/timestamp" }
        }
      }
    }
  },
  "$defs": {
    "financial_period": {
      "type": "object",
      "required": [
        "period", "period_end", "form", "filed_date", "accession",
        "revenue", "cost_of_revenue", "gross_profit", "operating_income",
        "pretax_income", "net_income", "eps_diluted", "shares_diluted",
        "depreciation_amortization", "op_cash_flow", "capex", "sbc",
        "cash", "total_debt", "interest_expense", "total_assets",
        "total_equity", "current_assets", "current_liabilities",
        "receivables", "inventory"
      ],
      "properties": {
        "period": { "$ref": "common.json#/$defs/period" },
        "period_end": { "$ref": "common.json#/$defs/date" },
        "form": { "enum": ["10-K", "10-Q"] },
        "filed_date": { "$ref": "common.json#/$defs/date" },
        "accession": { "type": "string" },
        "revenue": { "$ref": "common.json#/$defs/value" },
        "cost_of_revenue": { "$ref": "common.json#/$defs/value" },
        "gross_profit": { "$ref": "common.json#/$defs/value" },
        "operating_income": { "$ref": "common.json#/$defs/value" },
        "pretax_income": { "$ref": "common.json#/$defs/value" },
        "net_income": { "$ref": "common.json#/$defs/value" },
        "eps_diluted": { "$ref": "common.json#/$defs/value" },
        "shares_diluted": { "$ref": "common.json#/$defs/value" },
        "depreciation_amortization": { "$ref": "common.json#/$defs/value" },
        "op_cash_flow": { "$ref": "common.json#/$defs/value" },
        "capex": {
          "description": "POSITIVE number meaning cash spent.",
          "$ref": "common.json#/$defs/value"
        },
        "sbc": { "$ref": "common.json#/$defs/value" },
        "cash": { "$ref": "common.json#/$defs/value" },
        "total_debt": { "$ref": "common.json#/$defs/value" },
        "interest_expense": { "$ref": "common.json#/$defs/value" },
        "total_assets": { "$ref": "common.json#/$defs/value" },
        "total_equity": { "$ref": "common.json#/$defs/value" },
        "current_assets": { "$ref": "common.json#/$defs/value" },
        "current_liabilities": { "$ref": "common.json#/$defs/value" },
        "receivables": { "$ref": "common.json#/$defs/value" },
        "inventory": { "$ref": "common.json#/$defs/value" }
      }
    }
  }
}
