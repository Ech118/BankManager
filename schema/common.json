{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bankmanager.local/schema/common.json",
  "title": "Shared definitions",
  "description": "GENERATED from schema/contracts/common.py. The ValueObject and its four conditional rules, shared by every other contract.",
  "$defs": {
    "Unit": {
      "description": "Unit of a ValueObject. `fraction` is never a percent (0.25 means 25%).",
      "enum": [
        "usd",
        "usd_per_share",
        "shares",
        "fraction",
        "multiple",
        "count",
        "days",
        "ratio"
      ],
      "title": "Unit",
      "type": "string"
    },
    "ValueStatus": {
      "description": "`unavailable` is the ONLY way to express missing data. Never 0, never \"N/A\".",
      "enum": [
        "ok",
        "unavailable"
      ],
      "title": "ValueStatus",
      "type": "string"
    },
    "ValueType": {
      "description": "Epistemic status of a number, rendered as a colour in the report.\n\nfact       reported in a filing, or computed in code from reported values\nestimate   a forecast: consensus, or a scenario output\nassumption a chosen constant: discount rate, terminal growth, exit multiple",
      "enum": [
        "fact",
        "estimate",
        "assumption"
      ],
      "title": "ValueType",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "number"
          }
        },
        "required": [
          "value"
        ]
      },
      "title": "status ok requires a numeric value"
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "source_id": {
                "type": "string"
              }
            },
            "required": [
              "source_id"
            ]
          },
          {
            "properties": {
              "derived_from": {
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "derived_from"
            ]
          }
        ]
      },
      "title": "status ok requires a source_id or a non-empty derived_from"
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      },
      "title": "status unavailable requires a null value"
    },
    {
      "if": {
        "properties": {
          "unit": {
            "const": "fraction"
          }
        },
        "required": [
          "unit"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": -10.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "title": "fractions are fractions, not percents"
    }
  ],
  "properties": {
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "The number in full units, or null when status is unavailable.",
      "title": "Value"
    },
    "unit": {
      "$ref": "#/$defs/Unit"
    },
    "type": {
      "$ref": "#/$defs/ValueType"
    },
    "status": {
      "$ref": "#/$defs/ValueStatus"
    },
    "source_id": {
      "anyOf": [
        {
          "pattern": "^src:[a-z0-9_]+:[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Where the number came from. Required unless derived_from is set.",
      "title": "Source Id"
    },
    "derived_from": {
      "description": "Dotted paths or fact_ids this value was computed from.",
      "items": {
        "type": "string"
      },
      "title": "Derived From",
      "type": "array"
    }
  },
  "required": [
    "value",
    "unit",
    "type",
    "status"
  ],
  "type": "object"
}
