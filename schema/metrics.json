{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bankmanager.local/schema/metrics.json",
  "title": "Computed metrics",
  "description": "GENERATED from schema/contracts/metrics.py. PRODUCED BY P2 (calc.api.compute_metrics). Every leaf computed in code.",
  "$defs": {
    "BalanceSheet": {
      "additionalProperties": true,
      "properties": {
        "net_debt": {
          "$ref": "#/$defs/ValueObject",
          "description": "Positive when debt exceeds cash."
        },
        "net_debt_to_ebitda": {
          "$ref": "#/$defs/ValueObject"
        },
        "interest_coverage": {
          "$ref": "#/$defs/ValueObject",
          "description": "Operating income / interest expense."
        },
        "current_ratio": {
          "$ref": "#/$defs/ValueObject"
        }
      },
      "required": [
        "net_debt",
        "net_debt_to_ebitda",
        "interest_coverage",
        "current_ratio"
      ],
      "title": "BalanceSheet",
      "type": "object"
    },
    "CashFlow": {
      "additionalProperties": true,
      "description": "Cash generation. `ebitda` is unadjusted on purpose: operating income + D&A.",
      "properties": {
        "fcf": {
          "$ref": "#/$defs/ValueObject",
          "description": "op_cash_flow - capex."
        },
        "fcf_conversion": {
          "$ref": "#/$defs/ValueObject",
          "description": "FCF / net income."
        },
        "fcf_yield": {
          "$ref": "#/$defs/ValueObject",
          "description": "FCF / market cap."
        },
        "capex_intensity": {
          "$ref": "#/$defs/ValueObject",
          "description": "Capex / revenue."
        },
        "ebitda": {
          "$ref": "#/$defs/ValueObject",
          "description": "Operating income + D&A, UNADJUSTED."
        }
      },
      "required": [
        "fcf",
        "fcf_conversion",
        "fcf_yield",
        "capex_intensity",
        "ebitda"
      ],
      "title": "CashFlow",
      "type": "object"
    },
    "DcfAssumptions": {
      "additionalProperties": true,
      "description": "Tagged ASSUMPTION so the report colour-codes them (error D).",
      "properties": {
        "discount_rate": {
          "$ref": "#/$defs/ValueObject"
        },
        "terminal_growth": {
          "$ref": "#/$defs/ValueObject"
        },
        "horizon_years": {
          "minimum": 1,
          "title": "Horizon Years",
          "type": "integer"
        }
      },
      "required": [
        "discount_rate",
        "terminal_growth",
        "horizon_years"
      ],
      "title": "DcfAssumptions",
      "type": "object"
    },
    "FlagSeverity": {
      "description": "Earnings-quality flag severity raised by calc/. Informational, never fatal.",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "FlagSeverity",
      "type": "string"
    },
    "Growth": {
      "additionalProperties": true,
      "description": "Year-over-year change. Only emitted where a prior comparable period exists.",
      "properties": {
        "revenue_yoy": {
          "$ref": "#/$defs/ValueObject"
        },
        "eps_yoy": {
          "$ref": "#/$defs/ValueObject"
        },
        "fcf_yoy": {
          "$ref": "#/$defs/ValueObject"
        }
      },
      "required": [
        "revenue_yoy",
        "eps_yoy",
        "fcf_yoy"
      ],
      "title": "Growth",
      "type": "object"
    },
    "Margins": {
      "additionalProperties": true,
      "description": "Profitability at one period. Fractions, never percents.",
      "properties": {
        "gross": {
          "$ref": "#/$defs/ValueObject"
        },
        "operating": {
          "$ref": "#/$defs/ValueObject"
        },
        "net": {
          "$ref": "#/$defs/ValueObject"
        },
        "fcf": {
          "$ref": "#/$defs/ValueObject"
        }
      },
      "required": [
        "gross",
        "operating",
        "net",
        "fcf"
      ],
      "title": "Margins",
      "type": "object"
    },
    "PerShare": {
      "additionalProperties": true,
      "description": "Dilution and stock-based compensation, the two ways per-share results drift.",
      "properties": {
        "dilution_yoy": {
          "$ref": "#/$defs/ValueObject",
          "description": "Change in diluted shares; negative means a shrinking share count."
        },
        "sbc_pct_revenue": {
          "$ref": "#/$defs/ValueObject"
        },
        "sbc_pct_fcf": {
          "$ref": "#/$defs/ValueObject"
        }
      },
      "required": [
        "dilution_yoy",
        "sbc_pct_revenue",
        "sbc_pct_fcf"
      ],
      "title": "PerShare",
      "type": "object"
    },
    "QualityFlag": {
      "additionalProperties": true,
      "description": "A deterministic earnings-quality warning raised by calc/, not by an agent.",
      "properties": {
        "flag": {
          "description": "Machine-readable id, e.g. dso_rising.",
          "minLength": 1,
          "title": "Flag",
          "type": "string"
        },
        "detail": {
          "description": "What was observed, with numbers.",
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/FlagSeverity"
        }
      },
      "required": [
        "flag",
        "detail",
        "severity"
      ],
      "title": "QualityFlag",
      "type": "object"
    },
    "ReverseDcf": {
      "additionalProperties": true,
      "description": "What growth the current price already implies.\n\nA single point answer would be misleading, so `sensitivity_grid` is required\nand must never be empty (error D, ADR 0001).",
      "properties": {
        "implied_fcf_cagr": {
          "$ref": "#/$defs/ValueObject",
          "description": "Annual FCF growth over the horizon implied by today's price."
        },
        "assumptions": {
          "$ref": "#/$defs/DcfAssumptions"
        },
        "sensitivity_grid": {
          "description": "Never a single point answer.",
          "items": {
            "$ref": "#/$defs/SensitivityRow"
          },
          "minItems": 1,
          "title": "Sensitivity Grid",
          "type": "array"
        }
      },
      "required": [
        "implied_fcf_cagr",
        "assumptions",
        "sensitivity_grid"
      ],
      "title": "ReverseDcf",
      "type": "object"
    },
    "SensitivityRow": {
      "additionalProperties": true,
      "description": "One cell of the sensitivity grid. Bare numbers here are a documented exception.",
      "properties": {
        "discount_rate": {
          "title": "Discount Rate",
          "type": "number"
        },
        "terminal_growth": {
          "title": "Terminal Growth",
          "type": "number"
        },
        "implied_fcf_cagr": {
          "$ref": "#/$defs/ValueObject"
        }
      },
      "required": [
        "discount_rate",
        "terminal_growth",
        "implied_fcf_cagr"
      ],
      "title": "SensitivityRow",
      "type": "object"
    },
    "Unit": {
      "description": "Unit of a ValueObject. `fraction` is never a percent (0.25 means 25%).",
      "enum": [
        "usd",
        "usd_per_share",
        "shares",
        "fraction",
        "multiple",
        "count",
        "days",
        "ratio"
      ],
      "title": "Unit",
      "type": "string"
    },
    "Valuation": {
      "additionalProperties": true,
      "properties": {
        "pe": {
          "$ref": "#/$defs/ValueObject"
        },
        "forward_pe": {
          "$ref": "#/$defs/ValueObject"
        },
        "ev_ebitda": {
          "$ref": "#/$defs/ValueObject"
        },
        "ev_revenue": {
          "$ref": "#/$defs/ValueObject"
        },
        "p_fcf": {
          "$ref": "#/$defs/ValueObject"
        },
        "vs_peers": {
          "$ref": "#/$defs/VsPeers"
        },
        "vs_sp500": {
          "$ref": "#/$defs/VsSP500"
        }
      },
      "required": [
        "pe",
        "forward_pe",
        "ev_ebitda",
        "ev_revenue",
        "p_fcf",
        "vs_peers",
        "vs_sp500"
      ],
      "title": "Valuation",
      "type": "object"
    },
    "ValueObject": {
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          },
          "title": "status ok requires a numeric value"
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "source_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "source_id"
                ]
              },
              {
                "properties": {
                  "derived_from": {
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "derived_from"
                ]
              }
            ]
          },
          "title": "status ok requires a source_id or a non-empty derived_from"
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "title": "status unavailable requires a null value"
        },
        {
          "if": {
            "properties": {
              "unit": {
                "const": "fraction"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "maximum": 10.0,
                    "minimum": -10.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "title": "fractions are fractions, not percents"
        }
      ],
      "description": "Every reported or computed financial number in the system.\n\nFractions, not percents. Money in full USD. Missing data is\n{\"value\": null, \"status\": \"unavailable\"} - never 0, never \"N/A\", never an\nomitted key.\n\nA value computed in code from facts has type \"fact\" and lists `derived_from`.\nDiscount rate, terminal growth and exit multiples are \"assumption\".\nConsensus numbers and scenario outputs are \"estimate\".",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The number in full units, or null when status is unavailable.",
          "title": "Value"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "type": {
          "$ref": "#/$defs/ValueType"
        },
        "status": {
          "$ref": "#/$defs/ValueStatus"
        },
        "source_id": {
          "anyOf": [
            {
              "pattern": "^src:[a-z0-9_]+:[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the number came from. Required unless derived_from is set.",
          "title": "Source Id"
        },
        "derived_from": {
          "description": "Dotted paths or fact_ids this value was computed from.",
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        }
      },
      "required": [
        "value",
        "unit",
        "type",
        "status"
      ],
      "title": "ValueObject",
      "type": "object"
    },
    "ValueStatus": {
      "description": "`unavailable` is the ONLY way to express missing data. Never 0, never \"N/A\".",
      "enum": [
        "ok",
        "unavailable"
      ],
      "title": "ValueStatus",
      "type": "string"
    },
    "ValueType": {
      "description": "Epistemic status of a number, rendered as a colour in the report.\n\nfact       reported in a filing, or computed in code from reported values\nestimate   a forecast: consensus, or a scenario output\nassumption a chosen constant: discount rate, terminal growth, exit multiple",
      "enum": [
        "fact",
        "estimate",
        "assumption"
      ],
      "title": "ValueType",
      "type": "string"
    },
    "VsPeers": {
      "additionalProperties": true,
      "description": "Premium (+) or discount (-) to the peer MEDIAN, as fractions.",
      "properties": {
        "pe_premium": {
          "$ref": "#/$defs/ValueObject"
        },
        "ev_ebitda_premium": {
          "$ref": "#/$defs/ValueObject"
        }
      },
      "required": [
        "pe_premium",
        "ev_ebitda_premium"
      ],
      "title": "VsPeers",
      "type": "object"
    },
    "VsSP500": {
      "additionalProperties": true,
      "properties": {
        "forward_pe_premium": {
          "$ref": "#/$defs/ValueObject"
        }
      },
      "required": [
        "forward_pe_premium"
      ],
      "title": "VsSP500",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "ticker": {
      "pattern": "^[A-Z]{1,5}([.-][A-Z])?$",
      "title": "Ticker",
      "type": "string"
    },
    "as_of": {
      "description": "Copied from the factsheet; never passed separately.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "title": "As Of",
      "type": "string"
    },
    "latest_annual_period": {
      "pattern": "^(FY\\d{4}|Q[1-4]-\\d{4})$",
      "title": "Latest Annual Period",
      "type": "string"
    },
    "latest_balance_period": {
      "pattern": "^(FY\\d{4}|Q[1-4]-\\d{4})$",
      "title": "Latest Balance Period",
      "type": "string"
    },
    "margins": {
      "description": "period -> margins.",
      "patternProperties": {
        "^(FY\\d{4}|Q[1-4]-\\d{4})$": {
          "$ref": "#/$defs/Margins"
        }
      },
      "title": "Margins",
      "type": "object"
    },
    "growth": {
      "description": "period -> year-over-year growth.",
      "patternProperties": {
        "^(FY\\d{4}|Q[1-4]-\\d{4})$": {
          "$ref": "#/$defs/Growth"
        }
      },
      "title": "Growth",
      "type": "object"
    },
    "cash_flow": {
      "$ref": "#/$defs/CashFlow"
    },
    "balance_sheet": {
      "$ref": "#/$defs/BalanceSheet"
    },
    "per_share": {
      "$ref": "#/$defs/PerShare"
    },
    "quality_flags": {
      "items": {
        "$ref": "#/$defs/QualityFlag"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "valuation": {
      "$ref": "#/$defs/Valuation"
    },
    "reverse_dcf": {
      "$ref": "#/$defs/ReverseDcf"
    }
  },
  "required": [
    "schema_version",
    "ticker",
    "as_of",
    "latest_annual_period",
    "latest_balance_period",
    "margins",
    "growth",
    "cash_flow",
    "balance_sheet",
    "per_share",
    "valuation",
    "reverse_dcf"
  ],
  "type": "object"
}
