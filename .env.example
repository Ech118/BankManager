# FROZEN (Step 0). Copy to .env (gitignored) and fill in YOUR OWN keys.
# Never commit real values. A partition needing a new variable adds it to
# <dir>/.env.additions.example and files a request (CONTRIBUTING.md).

# --- modes ---------------------------------------------------------------
# MODE=mock      fixtures/mock (ACME). No network, no database, no keys.
# MODE=live      real implementations, real data, real database.
MODE=mock

# LLM_MODE is SEPARATE from MODE on purpose: it lets P1 and P2 build and test
# with no Anthropic key at all, and keeps the contract suite offline.
# LLM_MODE=mock  canned agent outputs from fixtures/mock/analysis_*.json
# LLM_MODE=live  real Claude API calls
LLM_MODE=mock

# --- LLM -----------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- database (MODE=live only) -------------------------------------------
# Mock mode needs no database. `make db-up` starts a local Postgres.
DATABASE_URL=postgresql://bankmanager:bankmanager@localhost:5432/bankmanager

# --- data providers (P1) -------------------------------------------------
# EDGAR REQUIRES a descriptive User-Agent with contact details. Without one you
# will be blocked, usually mid-demo.
# Example: "BankManager Research you@example.com"
SEC_USER_AGENT=

FMP_API_KEY=
FRED_API_KEY=
TAVILY_API_KEY=

# --- test helpers --------------------------------------------------------
# Used by `make check-live BM_TEST_TICKER=MSFT`.
BM_TEST_TICKER=
BM_TEST_AS_OF=
