# FROZEN (Step 0). Copy to .env (gitignored) and fill in YOUR OWN keys. Never commit real values.
# A partition needing a new variable adds it to <dir>/.env.additions.example and files a request.

# --- modes (plan.txt 15.9) ---
# mock = fixtures/mock (ACME), works offline. live = real implementation where it exists.
BM_MODE=mock
BM_LLM=mock

# --- LLM ---
ANTHROPIC_API_KEY=

# --- data providers (P1) ---
# EDGAR requires a descriptive User-Agent with contact info, e.g. "BankManager Hackathon you@example.com"
SEC_USER_AGENT=
FMP_API_KEY=
FRED_API_KEY=
TAVILY_API_KEY=
