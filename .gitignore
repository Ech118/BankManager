# FROZEN (Step 0). A partition needing extra ignores creates a NESTED .gitignore
# inside its own directory instead of editing this file (git honours it).

# secrets
.env
.env.*
!.env.example
*.pem
id_rsa
id_ed25519

# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# node
node_modules/
.next/
out/
dist/

# caches / local state
.cache/
.DS_Store
.claude/settings.local.json

# local database and generated run artifacts
pgdata/
*.sqlite
*.sqlite3

# forward prediction log: the code ships, the records do not
predictions/log/

# rendered reports and charts
reports/
*.png
!docs/**/*.png
